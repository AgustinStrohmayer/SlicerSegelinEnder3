/* SlicerSegelinEnder3 — light theme.
 * Tokens substituted by ui/theming/qss.py at load time.
 */

* {
    font-family: {{typography.family}};
    font-size: {{typography.size_body}}px;
    color: {{color.text}};
}

QMainWindow, QDialog {
    background-color: {{color.bg}};
}

QWidget {
    background-color: transparent;
}

QToolTip {
    background: {{color.surface}};
    color: {{color.text}};
    border: 1px solid {{color.border_strong}};
    padding: 6px 10px;
    border-radius: {{radius.sm}}px;
}

QLabel[role="title"] {
    font-size: {{typography.size_title}}px;
    font-weight: {{typography.weight_semibold}};
    color: {{color.text_strong}};
}

QLabel[role="display"] {
    font-size: {{typography.size_display}}px;
    font-weight: {{typography.weight_bold}};
    color: {{color.text_strong}};
}

QLabel[role="caption"], QLabel.muted {
    color: {{color.muted}};
    font-size: {{typography.size_caption}}px;
    font-weight: {{typography.weight_medium}};
    letter-spacing: 0.3px;
}

QLabel[role="mono"] {
    font-family: {{typography.family_mono}};
    color: {{color.text}};
}

QLabel[role="kbd"] {
    background: {{color.surface_alt}};
    border: 1px solid {{color.border_strong}};
    border-radius: {{radius.sm}}px;
    padding: 2px 6px;
    font-family: {{typography.family_mono}};
    font-size: {{typography.size_caption}}px;
    color: {{color.muted}};
}

QToolBar {
    background: {{color.bg}};
    border: none;
    border-bottom: 1px solid {{color.border}};
    padding: {{space.sm}}px {{space.md}}px;
    spacing: {{space.xs}}px;
    min-height: 48px;
}

QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: {{radius.sm}}px;
    padding: 6px 10px;
    color: {{color.text}};
}

QToolBar QToolButton:hover {
    background: {{color.surface_alt}};
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background: {{color.accent_subtle}};
    color: {{color.accent}};
}

QToolBar::separator {
    background: {{color.border}};
    width: 1px;
    margin: 6px 6px;
}

QMenuBar {
    background: {{color.bg}};
    border-bottom: 1px solid {{color.border}};
    padding: {{space.xs}}px {{space.sm}}px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: {{radius.sm}}px;
}

QMenuBar::item:selected {
    background: {{color.surface_alt}};
}

QMenu {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}}px;
    padding: {{space.xs}}px;
}

QMenu::item {
    padding: 8px 14px;
    border-radius: {{radius.sm}}px;
}

QMenu::item:selected {
    background: {{color.accent_subtle}};
    color: {{color.accent}};
}

QMenu::separator {
    height: 1px;
    background: {{color.border}};
    margin: {{space.xs}}px {{space.sm}}px;
}

QDockWidget {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    color: {{color.text}};
}

QDockWidget::title {
    background: {{color.surface}};
    padding: {{space.sm}}px {{space.md}}px;
    border-bottom: 1px solid {{color.border}};
    font-weight: {{typography.weight_semibold}};
}

QFrame#SidebarFrame {
    background: {{color.surface}};
    border-right: 1px solid {{color.border}};
}

QFrame#VerticalNav {
    background: {{color.bg}};
    border-right: 1px solid {{color.border}};
}

QToolButton#NavTab {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    padding: 12px 0px;
    color: {{color.muted}};
}

QToolButton#NavTab:hover {
    color: {{color.text}};
    background: {{color.surface_alt}};
}

QToolButton#NavTab:checked {
    color: {{color.accent}};
    background: {{color.accent_subtle}};
    border-left-color: {{color.accent}};
}

QLabel#PanelTitle {
    font-size: {{typography.size_title}}px;
    font-weight: {{typography.weight_semibold}};
    color: {{color.text_strong}};
}

QLabel#PanelCaption {
    color: {{color.muted}};
    font-size: {{typography.size_small}}px;
}

QFrame#PanelDivider {
    background: {{color.border}};
    max-height: 1px;
    min-height: 1px;
    margin: 4px 0;
}

QLabel#FieldLabel {
    color: {{color.muted}};
    font-size: {{typography.size_caption}}px;
    font-weight: {{typography.weight_medium}};
    letter-spacing: 0.4px;
    text-transform: uppercase;
}

QStatusBar {
    background: {{color.bg}};
    border-top: 1px solid {{color.border}};
    color: {{color.muted}};
    padding: 4px {{space.md}}px;
    min-height: 28px;
}

QStatusBar::item { border: none; }

QStatusBar QLabel {
    color: {{color.muted}};
    padding: 0 {{space.sm}}px;
}

QStatusBar QLabel[role="mono"] {
    font-family: {{typography.family_mono}};
    color: {{color.text}};
}

QPushButton {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
    padding: 8px 14px;
    color: {{color.text}};
    min-height: 32px;
    font-weight: {{typography.weight_medium}};
}

QPushButton:hover {
    background: {{color.surface_alt}};
    border-color: {{color.border_strong}};
}

QPushButton:pressed {
    background: {{color.border}};
}

QPushButton:focus {
    border-color: {{color.accent}};
}

QPushButton:disabled {
    color: {{color.muted}};
    background: {{color.surface_alt}};
    border-color: {{color.border}};
}

QPushButton[role="primary"] {
    background: {{color.accent}};
    border-color: {{color.accent}};
    color: white;
    font-weight: {{typography.weight_semibold}};
}

QPushButton[role="primary"]:hover {
    background: {{color.accent_hover}};
    border-color: {{color.accent_hover}};
}

QPushButton[role="primary"]:disabled {
    background: {{color.surface_alt}};
    border-color: {{color.border}};
    color: {{color.muted}};
}

QPushButton[role="danger"] {
    background: transparent;
    border-color: {{color.danger}};
    color: {{color.danger}};
}

QPushButton[role="danger"]:hover {
    background: {{color.danger}};
    color: white;
}

QPushButton[role="ghost"] {
    background: transparent;
    border-color: transparent;
    color: {{color.muted}};
}

QPushButton[role="ghost"]:hover {
    background: {{color.surface_alt}};
    color: {{color.text}};
}

QPushButton[role="ghost"]:checked {
    background: {{color.accent_subtle}};
    color: {{color.accent}};
    border-color: {{color.accent_subtle}};
}

QPushButton[size="compact"] {
    min-height: 26px;
    padding: 4px 10px;
}

QPushButton[size="lg"] {
    min-height: 40px;
    padding: 10px 18px;
    font-size: {{typography.size_title}}px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: {{radius.sm}}px;
    padding: 4px 8px;
    color: {{color.text}};
}

QToolButton:hover {
    background: {{color.surface_alt}};
}

QToolButton:checked {
    background: {{color.accent_subtle}};
    color: {{color.accent}};
}

QToolButton#CanvasFloatBtn {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
    min-width: 28px;
    min-height: 28px;
}

QToolButton#CanvasFloatBtn:hover {
    background: {{color.surface_alt}};
    border-color: {{color.accent}};
    color: {{color.accent}};
}

QCheckBox {
    color: {{color.text}};
    spacing: 8px;
    padding: 4px 0;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid {{color.border_strong}};
    border-radius: 4px;
    background: {{color.surface}};
}

QCheckBox::indicator:hover {
    border-color: {{color.accent}};
}

QCheckBox::indicator:checked {
    background: {{color.accent}};
    border-color: {{color.accent}};
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
    padding: 6px 10px;
    color: {{color.text}};
    selection-background-color: {{color.accent}};
    min-height: 28px;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border-color: {{color.border_strong}};
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: {{color.accent}};
    background: {{color.bg}};
}

QLineEdit[invalid="true"] {
    border-color: {{color.danger}};
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
    padding: {{space.xs}}px;
    selection-background-color: {{color.accent_subtle}};
    selection-color: {{color.accent}};
}

QListWidget, QListView {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
    padding: {{space.xs}}px;
    outline: none;
}

QListWidget::item, QListView::item {
    padding: 8px 10px;
    border-radius: {{radius.sm}}px;
    margin: 1px 0;
}

QListWidget::item:hover, QListView::item:hover {
    background: {{color.surface_alt}};
}

QListWidget::item:selected, QListView::item:selected {
    background: {{color.accent_subtle}};
    color: {{color.accent}};
}

QSlider::groove:horizontal {
    height: 4px;
    background: {{color.border}};
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: {{color.accent}};
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: {{color.accent_hover}};
}

QSlider::sub-page:horizontal {
    background: {{color.accent}};
    border-radius: 2px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: {{color.border_strong}};
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: {{color.muted}};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: {{color.border_strong}};
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: {{color.muted}};
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

QGraphicsView {
    background: {{color.bg}};
    border: none;
}

QWidget#CanvasContainer {
    background: {{color.bg}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}}px;
}

QWidget#Ruler {
    background: {{color.surface}};
    border-bottom: 1px solid {{color.border}};
    border-right: 1px solid {{color.border}};
}

QLabel#CoordReadout {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
    padding: 6px 10px;
    color: {{color.text}};
    font-family: {{typography.family_mono}};
    font-size: {{typography.size_small}}px;
}

QLabel#ZoomBadge {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}}px;
    padding: 4px 10px;
    color: {{color.muted}};
    font-family: {{typography.family_mono}};
    font-size: {{typography.size_caption}}px;
}

QFrame#FloatingControls {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}}px;
    padding: 4px;
}

QFrame#EmptyState { background: transparent; }

QLabel#EmptyStateIcon {
    background: {{color.accent_subtle}};
    border-radius: 36px;
    min-width: 72px;
    min-height: 72px;
    max-width: 72px;
    max-height: 72px;
}

QFrame#Toast {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}}px;
    padding: {{space.sm}}px {{space.md}}px;
}

QFrame#Toast[severity="success"] { border-left: 3px solid {{color.success}}; }
QFrame#Toast[severity="warning"] { border-left: 3px solid {{color.warning}}; }
QFrame#Toast[severity="danger"]  { border-left: 3px solid {{color.danger}}; }
QFrame#Toast[severity="info"]    { border-left: 3px solid {{color.accent}}; }

QFrame#CommandPalette, QFrame#ShortcutsOverlay {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.lg}}px;
}

QWidget#OverlayBackdrop {
    background: {{color.overlay}};
}

QFrame#CommandPalette QLineEdit {
    background: transparent;
    border: none;
    border-bottom: 1px solid {{color.border}};
    border-radius: 0;
    padding: {{space.md}}px {{space.lg}}px;
    font-size: {{typography.size_title}}px;
}

QFrame#CommandPalette QListWidget,
QFrame#CommandPalette QListView {
    background: transparent;
    border: none;
    padding: {{space.xs}}px;
}

QFrame#CommandPalette QListView::item { padding: 10px 12px; }

QFrame#Welcome { background: {{color.bg}}; }

QFrame#WelcomeCard {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.lg}}px;
    padding: {{space.xxl}}px;
}

QFrame#RecentItem {
    background: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}}px;
    padding: {{space.md}}px {{space.lg}}px;
}

QFrame#RecentItem:hover {
    background: {{color.surface_alt}};
    border-color: {{color.accent}};
}
